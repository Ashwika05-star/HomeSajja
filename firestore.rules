rules_version = '2';

// Baseline HomeSajja rules. Status changes are limited to the right party and
// the right fields, but the exact allowed transitions (e.g. PENDING -> ACCEPTED
// only) are not enforced here — that hardening belongs with Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Fields that differ between the stored document and the incoming write.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function vendorExists(uid) {
      return exists(/databases/$(database)/documents/vendors/$(uid));
    }

    function isRecycler(uid) {
      return vendorExists(uid)
        && get(/databases/$(database)/documents/vendors/$(uid)).data.businessType == 'RECYCLER';
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // ---------- accounts ----------
    // The two roles are permanent: a uid may own a users doc or a vendors doc, never both.
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && incoming().uid == uid && !vendorExists(uid);
      allow update: if isSelf(uid) && incoming().uid == uid;
      allow delete: if isSelf(uid);
    }

    // `verified` is a placeholder badge: a vendor can never turn it on for themselves
    // (an admin edits it in the console).
    match /vendors/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid) && incoming().uid == uid && !userExists(uid)
        && incoming().get('verified', false) == false;
      allow update: if isSelf(uid) && incoming().uid == uid
        && incoming().get('verified', false) == existing().get('verified', false);
      allow delete: if isSelf(uid);
    }

    // ---------- marketplace ----------
    // Readable by any signed-in user; only the owner can create, edit or delete.
    // One exception: the two parties of an exchange may move the status of the two
    // listings in it (see exchangeMovesListing).
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSelf(incoming().ownerId)
        && incoming().status == 'ACTIVE'
        && incoming().title is string && incoming().title.size() > 0
        && incoming().price is int && incoming().price >= 0
        && incoming().images.size() >= 1 && incoming().images.size() <= 5;
      allow update: if (isSelf(existing().ownerId) && incoming().ownerId == existing().ownerId)
        || exchangeMovesListing(listingId);
      allow delete: if isSelf(existing().ownerId);
    }

    // The exchange this write refers to (`exchangeRequestId` on the listing) is read as it
    // will be *after* the same batch/transaction, so the request and both listings must
    // change together: ACCEPTED reserves the item, COMPLETED marks it exchanged.
    function exchangeMovesListing(listingId) {
      let exchange = getAfter(/databases/$(database)/documents/exchangeRequests/$(incoming().exchangeRequestId)).data;
      return isSignedIn()
        && changedKeys().hasOnly(['status', 'updatedAt', 'exchangeRequestId'])
        && request.auth.uid in [exchange.senderId, exchange.receiverId]
        && listingId in [exchange.offeredListingId, exchange.requestedListingId]
        && ((exchange.status == 'ACCEPTED' && existing().status == 'ACTIVE' && incoming().status == 'RESERVED')
            || (exchange.status == 'COMPLETED' && existing().status == 'RESERVED' && incoming().status == 'EXCHANGED'));
    }

    // Buyer <-> seller. The seller answers; the buyer can only cancel.
    match /purchaseRequests/{requestId} {
      allow get: if isSignedIn()
        && (resource == null || (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId));
      allow list: if isSignedIn()
        && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow create: if isSelf(incoming().buyerId)
        && incoming().sellerId != incoming().buyerId
        && incoming().status == 'REQUESTED'
        && get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.ownerId == incoming().sellerId;
      allow update: if changedKeys().hasOnly(['status', 'updatedAt'])
        && (isSelf(existing().sellerId)
            || (isSelf(existing().buyerId) && incoming().status == 'CANCELLED'));
      allow delete: if isSelf(existing().buyerId) && existing().status == 'REQUESTED';
    }

    // Sender <-> receiver. The sender offers one of their own active listings for the
    // receiver's active exchange listing. Unlike the other systems, the status pipeline is
    // enforced here: PENDING -> ACCEPTED/DECLINED (receiver) or CANCELLED (sender), and
    // ACCEPTED -> COMPLETED (either party).
    match /exchangeRequests/{requestId} {
      allow get: if isSignedIn()
        && (resource == null
            || (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId));
      allow list: if isSignedIn()
        && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow create: if isSelf(incoming().senderId)
        && incoming().receiverId != incoming().senderId
        && incoming().status == 'PENDING'
        && get(/databases/$(database)/documents/listings/$(incoming().offeredListingId)).data.ownerId == incoming().senderId
        && get(/databases/$(database)/documents/listings/$(incoming().offeredListingId)).data.status == 'ACTIVE'
        && get(/databases/$(database)/documents/listings/$(incoming().requestedListingId)).data.ownerId == incoming().receiverId
        && get(/databases/$(database)/documents/listings/$(incoming().requestedListingId)).data.status == 'ACTIVE'
        && get(/databases/$(database)/documents/listings/$(incoming().requestedListingId)).data.actionType == 'EXCHANGE';
      allow update: if changedKeys().hasOnly(['status', 'updatedAt'])
        && ((existing().status == 'PENDING'
              && ((isSelf(existing().receiverId) && incoming().status in ['ACCEPTED', 'DECLINED'])
                  || (isSelf(existing().senderId) && incoming().status == 'CANCELLED')))
            || (existing().status == 'ACCEPTED'
                && (isSelf(existing().senderId) || isSelf(existing().receiverId))
                && incoming().status == 'COMPLETED'));
      allow delete: if isSelf(existing().senderId) && existing().status == 'PENDING';
    }

    // ---------- repair & recycling ----------
    // User <-> the one vendor they chose. The status pipeline is enforced here:
    // REQUESTED -> ACCEPTED/REJECTED -> IN_PROGRESS -> READY -> COMPLETED, all moved by the
    // vendor; the user can only CANCEL, and only before work starts.
    function repairVendorMove(from, to) {
      return (from == 'REQUESTED' && to in ['ACCEPTED', 'REJECTED'])
        || (from == 'ACCEPTED' && to == 'IN_PROGRESS')
        || (from == 'IN_PROGRESS' && to == 'READY')
        || (from == 'READY' && to == 'COMPLETED');
    }

    match /repairRequests/{requestId} {
      allow get: if isSignedIn()
        && (resource == null || (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.vendorId));
      allow list: if isSignedIn()
        && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.vendorId);
      allow create: if isSelf(incoming().userId)
        && userExists(incoming().userId)
        && vendorExists(incoming().vendorId)
        && incoming().status == 'REQUESTED'
        && (!('listingId' in incoming()) || incoming().listingId == null
            || get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.ownerId == incoming().userId);
      allow update: if changedKeys().hasOnly(['status', 'updatedAt'])
        && ((isSelf(existing().vendorId) && repairVendorMove(existing().status, incoming().status))
            || (isSelf(existing().userId)
                && existing().status in ['REQUESTED', 'ACCEPTED']
                && incoming().status == 'CANCELLED'));
      allow delete: if isSelf(existing().userId) && existing().status == 'REQUESTED';
    }

    // A drop-off is addressed to the recycler the user chose; a pickup has no vendor yet.
    // Pipeline: REQUESTED -> ACCEPTED/REJECTED -> SCHEDULED -> COMPLETED, all moved by the
    // recycler; the user can only CANCEL, and only before it is scheduled.
    function recyclingVendorMove(from, to) {
      return (from == 'REQUESTED' && to in ['ACCEPTED', 'REJECTED'])
        || (from == 'ACCEPTED' && to == 'SCHEDULED')
        || (from == 'SCHEDULED' && to == 'COMPLETED');
    }

    match /recyclingRequests/{requestId} {
      allow get: if isSignedIn()
        && (resource == null || (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.vendorId));
      // A recycler may also list the unclaimed pickups in their own city.
      allow list: if isSignedIn()
        && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.vendorId
            || (isRecycler(request.auth.uid)
                && resource.data.vendorId == null
                && resource.data.status == 'REQUESTED'
                && resource.data.city == get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.city));
      allow create: if isSelf(incoming().userId)
        && userExists(incoming().userId)
        && incoming().status == 'REQUESTED'
        && ((incoming().method == 'PICKUP' && incoming().vendorId == null)
            || (incoming().method == 'DROP_OFF'
                && vendorExists(incoming().vendorId)
                && get(/databases/$(database)/documents/vendors/$(incoming().vendorId)).data.businessType == 'RECYCLER'));
      allow update: if (changedKeys().hasOnly(['status', 'updatedAt'])
        && ((isSelf(existing().vendorId) && recyclingVendorMove(existing().status, incoming().status))
            || (isSelf(existing().userId)
                && existing().status in ['REQUESTED', 'ACCEPTED']
                && incoming().status == 'CANCELLED')))
        // A recycler in the same city claims an unassigned pickup and accepts it in the same write.
        || (existing().vendorId == null
            && existing().method == 'PICKUP'
            && existing().status == 'REQUESTED'
            && isRecycler(request.auth.uid)
            && existing().city == get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.city
            && changedKeys().hasOnly(['vendorId', 'vendorName', 'status', 'updatedAt'])
            && incoming().vendorId == request.auth.uid
            && incoming().status == 'ACCEPTED');
      allow delete: if isSelf(existing().userId) && existing().status == 'REQUESTED';
    }

    // ---------- vendor material board ----------
    // Public board: any signed-in user reads; only the owning vendor writes.
    match /materialRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSelf(incoming().vendorId)
        && vendorExists(request.auth.uid)
        && incoming().status == 'OPEN';
      allow update: if isSelf(existing().vendorId) && incoming().vendorId == existing().vendorId;
      allow delete: if isSelf(existing().vendorId);

      // Offers of furniture against a request. The doc id is the offerer's uid (one offer each).
      // The vendor reads all of them and accepts/declines; an offerer sees and can withdraw their own.
      match /offers/{offererId} {
        allow get: if isSignedIn()
          && (resource == null || request.auth.uid == offererId
              || request.auth.uid == get(/databases/$(database)/documents/materialRequests/$(requestId)).data.vendorId);
        allow list: if isSignedIn()
          && request.auth.uid == get(/databases/$(database)/documents/materialRequests/$(requestId)).data.vendorId;
        allow create: if isSelf(offererId)
          && incoming().offererId == offererId
          && incoming().status == 'PENDING'
          && userExists(offererId)
          && get(/databases/$(database)/documents/materialRequests/$(requestId)).data.status == 'OPEN'
          && get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.ownerId == offererId;
        allow update: if changedKeys().hasOnly(['status', 'updatedAt'])
          && existing().status == 'PENDING'
          && incoming().status in ['ACCEPTED', 'DECLINED']
          && isSelf(get(/databases/$(database)/documents/materialRequests/$(requestId)).data.vendorId);
        allow delete: if isSelf(offererId) && existing().status == 'PENDING';
      }
    }

    // ---------- chat ----------
    match /chats/{chatId} {
      allow get: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.auth.uid in incoming().participantIds
        && incoming().participantIds.size() == 2;
      // Participants can only refresh the last-message preview.
      allow update: if isSignedIn()
        && request.auth.uid in existing().participantIds
        && changedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastMessageSenderId']);
      allow delete: if false;

      match /messages/{messageId} {
        function chatParticipants() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }

        allow read: if isSignedIn() && request.auth.uid in chatParticipants();
        allow create: if isSignedIn()
          && request.auth.uid in chatParticipants()
          && incoming().senderId == request.auth.uid;
        allow update: if false;
        allow delete: if isSelf(existing().senderId);
      }
    }

    // ---------- notifications ----------
    // Created from the client for now (senderId must be the caller); only the
    // recipient can read, mark as seen, or delete.
    match /notifications/{notificationId} {
      allow get: if isSignedIn()
        && (resource == null || resource.data.recipientId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSelf(incoming().senderId);
      allow update: if isSelf(existing().recipientId) && changedKeys().hasOnly(['seen']);
      allow delete: if isSelf(existing().recipientId);
    }

    // ---------- reviews ----------
    // One review per person per transaction: the doc id encodes all three.
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSelf(incoming().reviewerId)
        && incoming().targetUserId != incoming().reviewerId
        && incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5
        && reviewId == incoming().reviewerId + '_' + incoming().contextType + '_' + incoming().contextId;
      allow update: if isSelf(existing().reviewerId)
        && changedKeys().hasOnly(['rating', 'comment', 'updatedAt'])
        && incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5;
      allow delete: if isSelf(existing().reviewerId);
    }

    // ---------- favourites ----------
    match /favourites/{favouriteId} {
      allow get: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSelf(incoming().userId)
        && favouriteId == incoming().userId + '_' + incoming().listingId;
      allow delete: if isSelf(existing().userId);
    }
  }
}
